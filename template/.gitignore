# Heavy or private files that never belong in this brand's history
node_modules/
*.key
.env*
.DS_Store
reels/*/build/
reels/*/audio/
reels/*/out/*.mp4
reels/*/out/*.mov
*.wav
*.mp3
*.bak-*
.cache/
__pycache__/

# Library media stays out of git (READMEs, INDEX.md and .gitkeep stay in)
brand/library/**/*.png
brand/library/**/*.jpg
brand/library/**/*.jpeg
brand/library/**/*.webp
brand/library/**/*.gif
brand/library/**/*.svg
brand/library/**/*.mp4
brand/library/**/*.mov
brand/library/**/*.webm

# The sticker host's photo and poses are a person's likeness: they stay out of git (host.json stays in)
brand/host/**/*.png
brand/host/**/*.jpg
brand/host/**/*.jpeg
brand/host/**/*.webp
brand/host/**/*.heic
